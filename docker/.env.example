# Copia este archivo a .env y define secretos locales. Nunca guardes .env en Git.
# PostgreSQL almacena/verifica las claves mediante SCRAM-SHA-256 al inicializar.
# PostgreSQL del ERP
ERP_POSTGRES_DB=erp_crm
ERP_POSTGRES_USER=erp_user
ERP_POSTGRES_PASSWORD=cambiar_esta_clave_localmente

# PostgreSQL exclusivo de SonarQube
SONAR_POSTGRES_DB=sonarqube
SONAR_POSTGRES_USER=sonar_user
SONAR_POSTGRES_PASSWORD=cambiar_esta_clave_localmente
