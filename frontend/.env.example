# Variables de entorno para las features CRM y Sesión/Identidad.
# Copia este archivo como .env.local y completa los valores necesarios para desarrollo.
# NUNCA subas .env.local al repositorio.

# Fuente de datos: 'mock' (por defecto, datos simulados en memoria para CRM y sesión de identidad)
#                  'api'  (conexión real al backend)
VITE_DATA_SOURCE=mock

# URL base de la API (vacío usa la misma origin que el frontend, útil con proxy Vite)
VITE_API_BASE_URL=

# En modo 'api', la autenticación y el tenant provendrán del usuario autenticado
# (el header X-Tenant-ID se derivará automáticamente de los claims/sesión del usuario autenticado).
# Solo para desarrollo local aislado con VITE_DATA_SOURCE=api (ignorados en producción):
VITE_DEV_ACCESS_TOKEN=
