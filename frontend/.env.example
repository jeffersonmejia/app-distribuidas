# Variables de entorno para la feature CRM.
# Copia este archivo como .env.local y completa los valores necesarios para desarrollo.
# NUNCA subas .env.local al repositorio.

# Fuente de datos: 'mock' (por defecto, datos simulados en memoria)
#                  'api'  (conexión real al backend)
VITE_DATA_SOURCE=

# URL base de la API (vacío usa la misma origin que el frontend, útil con proxy Vite)
VITE_API_BASE_URL=

# Solo para desarrollo local con VITE_DATA_SOURCE=api.
# Estos valores se leen únicamente cuando import.meta.env.DEV es true.
# En producción son ignorados automáticamente.
VITE_DEV_ACCESS_TOKEN=
VITE_DEV_TENANT_ID=
