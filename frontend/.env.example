# Variables de entorno para las features CRM, Inventario, Ventas (POS) y Sesión/Identidad.
# Copia este archivo como .env.local y completa los valores necesarios para desarrollo.
# NUNCA subas .env.local al repositorio.

# Fuente de datos para TODAS las features (CRM, Inventario y Ventas/POS):
#   'mock' — datos simulados en memoria, sin red (valor por defecto).
#            Usa InventoryMockRepository y PosMockRepository con datos de demostración.
#   'api'  — intenta conectarse al backend real.
#            Requiere un backend configurado, una ruta de red adecuada y
#            credenciales y membresía válidas; consulta docs/ejecucion-local.md.
VITE_DATA_SOURCE=mock

# URL base de la API (vacío usa la misma origin que el frontend, útil con proxy Vite)
VITE_API_BASE_URL=

# Solo para desarrollo local aislado con VITE_DATA_SOURCE=api (ignorados en producción).
# Las variables VITE son visibles en el navegador: usa únicamente un token de prueba
# de corta duración, nunca secretos permanentes ni credenciales de producción.
VITE_DEV_ACCESS_TOKEN=
VITE_DEV_TENANT_ID=
